	column Rating = IF(LEFT(audible_uncleaned[stars], 3) = "Not", BLANK(), VALUE(LEFT(audible_uncleaned[stars], SEARCH(" out of 5 stars", audible_uncleaned[stars]) - 1)))
		dataType: double
		formatString: 0.00
		lineageTag: 712241b1-632a-43a7-b076-ef169b3bd9ff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column RatingCount = VAR t = audible_uncleaned[stars] VAR pos = SEARCH("stars", t) VAR afterStars = SUBSTITUTE(MID(t, pos + 5, 30), ",", "") VAR cleaned = SUBSTITUTE(SUBSTITUTE(afterStars, " ratings", ""), " rating", "") RETURN IF(LEFT(t, 3) = "Not", BLANK(), VALUE(cleaned))
		dataType: int64
		formatString: #,0
		lineageTag: 712241b1-632a-43a7-b076-ef169b3bd9fe
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition audible_uncleaned = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(File.Contents("C:\Users\emira\Projects\GitHub-Projects\audiobook_cleaning_data\data\Audible_Cleaned_Dashboard.xlsx"), null, true),
				  #"Navigation 1" = Source{[Item = "audible_uncleaned", Kind = "Sheet"]}[Data],
				  #"Promoted headers" = Table.PromoteHeaders(#"Navigation 1", [PromoteAllScalars = true]),
				  #"Changed column type" = Table.TransformColumnTypes(#"Promoted headers", {{"name", type text}, {"Cleaned_author", type text}, {"Name of Auidobook", type text}, {"Cleaned_narrator", type text}, {"time", type text}, {"hours", Int64.Type}, {"minutes", Int64.Type}, {"total_minutes", Int64.Type}, {"release_date", type date}, {"language", type text}, {"stars", type text}, {"Column12", Currency.Type}}, "en-US"),
				  AllowedNameChars = {"a".."z"} & {"A".."Z"} & Text.ToList("ÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞßàáâãäåæçèéêëìíîïðñòóôõöøùúûüýþÿ") & {" ", ".", "-", "'", ","},
				  UpperNameChars = Text.ToList("ABCDEFGHIJKLMNOPQRSTUVWXYZÀÁÂÃÄÅÆÇÈÉÊËÌÍÎÏÐÑÒÓÔÕÖØÙÚÛÜÝÞ"),
				  CleanAuthorFn = (rawIn as any) as nullable text =>
				      try
				          let
				              raw0 = if rawIn = null then "" else Text.From(rawIn),
				              raw = Text.Trim(raw0),
				              words = Text.Split(raw, " "),
				              nonEmptyWords = List.Select(words, each _ <> ""),
				              deduped =
				                  if List.Count(nonEmptyWords) >= 2 and Text.EndsWith(Text.Combine(List.RemoveLastN(nonEmptyWords, 1), " "), List.Last(nonEmptyWords))
				                  then Text.Combine(List.RemoveLastN(nonEmptyWords, 1), " ")
				                  else raw,
				              cleanChars = Text.Select(deduped, AllowedNameChars),
				              len = Text.Length(deduped),
				              validLength = len >= 3,
				              validRatio = len > 0 and Number.From(Text.Length(cleanChars)) / Number.From(len) >= 0.85,
				              validStart = len > 0 and List.Contains(UpperNameChars, Text.Start(deduped, 1))
				          in
				              if validLength and validRatio and validStart then deduped else null
				      otherwise null,
				  #"Added Clean Author" = Table.AddColumn(#"Changed column type", "Clean Author", each CleanAuthorFn([Cleaned_author]), type text)
				in
				  #"Added Clean Author"

	annotation PBI_ResultType = Table

