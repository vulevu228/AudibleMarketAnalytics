table audible_uncleaned
	lineageTag: 8fe301ac-bd6c-456d-be18-0ad102483f1b

	measure 'Total Titles' = COUNTROWS(audible_uncleaned)
		formatString: #,0
		lineageTag: ab10001-2000-4a11-9a11-000000000001

	measure 'English Titles' = CALCULATE([Total Titles], audible_uncleaned[language] = "English")
		formatString: #,0
		lineageTag: ab10001-2000-4a11-9a11-000000000002

	measure 'Rated Titles' = CALCULATE([Total Titles], NOT ISBLANK(audible_uncleaned[Rating]))
		formatString: #,0
		lineageTag: ab10001-2000-4a11-9a11-000000000003

	measure '% Titles Rated' = DIVIDE([Rated Titles], [Total Titles])
		formatString: 0.0%
		lineageTag: ab10001-2000-4a11-9a11-000000000004

	measure 'Avg Price' = AVERAGE(audible_uncleaned[Price])
		formatString: "$"#,0.00
		lineageTag: ab10001-2000-4a11-9a11-000000000005

	measure 'Avg Price (English)' = CALCULATE([Avg Price], audible_uncleaned[language] = "English")
		formatString: "$"#,0.00
		lineageTag: ab10001-2000-4a11-9a11-000000000006

	measure 'Avg Rating' = AVERAGE(audible_uncleaned[Rating])
		formatString: 0.00
		lineageTag: ab10001-2000-4a11-9a11-000000000007

	measure 'Total Ratings' = SUM(audible_uncleaned[RatingCount])
		formatString: #,0
		lineageTag: ab10001-2000-4a11-9a11-000000000008

	measure 'Avg Duration (hrs)' = DIVIDE(AVERAGE(audible_uncleaned[total_minutes]), 60)
		formatString: #,0.0
		lineageTag: ab10001-2000-4a11-9a11-000000000009

